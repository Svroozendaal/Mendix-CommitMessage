# KnowledgeBase Creator Drop-In Configuration

# Mendix Studio Pro version root OR explicit mx.exe path.
MENDIX_STUDIO_PRO_PATH=C:\Program Files\Mendix\10.24.15.93102
# MENDIX_MX_EXE=C:\Program Files\Mendix\10.24.15.93102\modeler\mx.exe

# Mendix application path (folder or .mpr file).
MENDIX_APP_PATH=C:\Workspaces\Mendix\Smart Expenses app-main
# Optional when app folder has multiple .mpr files.
# MENDIX_MPR_PATH=C:\Workspaces\Mendix\Smart Expenses app-main\App.mpr

# Default output root. If empty, defaults to ../mendix-data (next to KnowledgeBase-Creator)
MENDIX_DATA_ROOT=

# Optional app name override for knowledge-base folder.
APP_NAME=SmartExpenses

# Optional module filter for parser. Use * for all.
MENDIX_MODULES=*

# Optional quality gate strict mode. true/false
STRICT_QUALITY_GATE=false
